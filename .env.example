# Copy this file to `.env` and fill in values as needed.
# The platform runs fully offline when a synthetic-data config is selected.
# All runtime overrides below are optional.

# --- Experiment tracking ---
# Backend for experiment tracking: "sqlite" (default), "json", "mlflow", or "none".
SIGNALATTICE_TRACKING_BACKEND=sqlite
# MLflow tracking URI (only used when backend=mlflow).
MLFLOW_TRACKING_URI=

# --- Runtime overrides (optional) ---
# Override the data directory (defaults to ./data).
SIGNALATTICE_DATA_DIR=
# Override the global random seed.
SIGNALATTICE_SEED=42
# Logging level: DEBUG, INFO, WARNING, ERROR
SIGNALATTICE_LOG_LEVEL=INFO

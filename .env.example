# Copy this file to `.env` and fill in values as needed.
# The platform runs fully without any of these (it falls back to free sources
# and synthetic data), so all keys below are OPTIONAL.

# --- Optional market data API keys ---
# Alpha Vantage (free tier): https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=

# --- Experiment tracking ---
# Backend for experiment tracking: "sqlite" (default) or "mlflow".
QRDP_TRACKING_BACKEND=sqlite
# MLflow tracking URI (only used when backend=mlflow).
MLFLOW_TRACKING_URI=

# --- Runtime overrides (optional) ---
# Override the data directory (defaults to ./data).
QRDP_DATA_DIR=
# Override the global random seed.
QRDP_SEED=42
# Logging level: DEBUG, INFO, WARNING, ERROR
QRDP_LOG_LEVEL=INFO
